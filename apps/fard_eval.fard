/// fard_eval — FARD evaluator written in FARD
/// Evaluates AST produced by fardparse (uses t/v fields, not op)
/// Int values come as strings from parser — convert with int.parse

import("std/list")  as list
import("std/rec")   as rec
import("std/str")   as str
import("std/int")   as int_mod
import("std/type")  as typ
import("../packages/fs-core/main") as fs
import("fardlex") as lex
import("fardparse") as parse

// ── Value constructors ────────────────────────────────────────────────────────

fn val_int(n)    { { t: "int",    v: n } }
fn val_float(f)  { { t: "float",  v: f } }
fn val_bool(b)   { { t: "bool",   v: b } }
fn val_null()    { { t: "null",   v: null } }
fn val_text(s)   { { t: "text",   v: s } }
fn val_list(xs)  { { t: "list",   v: xs } }
fn val_record(r) { { t: "record", v: r } }
fn val_fn(params, body, closure_env) { { t: "fn", params: params, body: body, closure_env: closure_env } }

fn is_truthy(val) {
  if val.t == "null" then false
  else if val.t == "bool" then val.v
  else if val.t == "int" then val.v != 0
  else true
}

fn while_step(init_state, cond_fn, body_fn) {
  let loop = while { state: init_state, steps: 0 } fn(acc) {
    is_truthy(apply(cond_fn, [acc.state]))
  } fn(acc) {
    {
      state: apply(body_fn, [acc.state]),
      steps: acc.steps + 1
    }
  } in
  {
    t: "record",
    v: {
      value: loop.value.state,
      steps: val_int(loop.value.steps),
      chain_hex: val_text("0")
    }
  }
}

fn parse_int(s) {
  let r = int_mod.parse(s) in
  if r.t == "ok" then r.v else 0
}

// ── Environment ───────────────────────────────────────────────────────────────

fn env_empty() { [] }

fn env_set(env, name, val) {
  list.append(env, { name: name, val: val })
}

fn env_get(env, name) {
  env_get_from(env, name, list.len(env) - 1)
}

fn env_get_from(env, name, i) {
  if i < 0 then null
  else
    let entry0 = list.get(env, i) in
    let entry = if typ.of(entry0) == "record" && rec.has(entry0, "name") then entry0 else { name: "", val: null } in
    if entry.name == name then entry.val
    else env_get_from(env, name, i - 1)
}
fn env_set_many(env, pairs) {
  list.fold(pairs, env, fn(acc, p) { env_set(acc, p.name, p.val) })
}

fn env_to_record_value(env) {
  val_record(list.fold(env, {}, fn(acc, entry) {
    rec.set(acc, entry.name, entry.val)
  }))
}

fn is_relative_import_path(path) {
  str.starts_with(path, "./") || str.starts_with(path, "../")
}

fn resolve_import_path(path) {
  if str.ends_with(path, ".fard") then path else str.concat([path, ".fard"])
}

fn eval_relative_import(path, env) {
  let read_result = fs.read(resolve_import_path(path)) in
  let source = if rec.has(read_result, "ok") then read_result.ok else read_result in
  let tokens = lex.tokenize(source) in
  let parsed = parse.parse_module(tokens, 0) in
  if !parsed.ok then { t: "error", msg: parsed.err } else
    eval_module_with_env_result(parsed.node, env)
}

fn bind_pattern(env, pat, val) {
  if pat.t == "list_pat" then
    if val.t != "list" then { t: "error", msg: "let_pat list_pat expected list" } else
      let names = pat.names in
      let env1 = list.fold(list.range(0, list.len(names)), env, fn(acc, i) {
        env_set(acc, list.get(names, i), list.get(val.v, i))
      }) in
      if rec.has(pat, "rest") && pat.rest != null then
        env_set(env1, pat.rest, val_list(list.drop(val.v, list.len(names))))
      else
        env1
  else if pat.t == "rec_pat" then
    if val.t != "record" then { t: "error", msg: "let_pat rec_pat expected record" } else
      list.fold(pat.fields, env, fn(acc, f) {
        env_set(acc, f.name, rec.get(val.v, f.key))
      })
  else
    { t: "error", msg: str.concat(["unsupported let_pat pattern: ", pat.t]) }
}

// ── Binary operators ──────────────────────────────────────────────────────────

fn eval_bin(op, l, r) {
  if op == "+"  then val_int(l.v + r.v)
  else if op == "-"  then val_int(l.v - r.v)
  else if op == "*"  then val_int(l.v * r.v)
  else if op == "/"  then val_int(l.v / r.v)
  else if op == "%"  then val_int(l.v % r.v)
  else if op == "==" then val_bool(l.v == r.v)
  else if op == "!=" then val_bool(l.v != r.v)
  else if op == "<"  then val_bool(l.v < r.v)
  else if op == "<=" then val_bool(l.v <= r.v)
  else if op == ">"  then val_bool(l.v > r.v)
  else if op == ">=" then val_bool(l.v >= r.v)
  else if op == "&&" then val_bool(is_truthy(l) && is_truthy(r))
  else if op == "||" then val_bool(is_truthy(l) || is_truthy(r))
  else { t: "error", msg: str.concat(["unknown op: ", op]) }
}

fn eval_unary(op, v) {
  if op == "-" then val_int(-v.v)
  else if op == "!" then val_bool(!is_truthy(v))
  else v
}

// ── Core evaluator ────────────────────────────────────────────────────────────

fn node_t(node) {
  if rec.has(node, "t") then node.t else node.op
}

fn node_var_name(node) {
  if rec.has(node, "v") then node.v else node.name
}

fn node_bin_op(node) {
  if rec.has(node, "op2") then node.op2 else node.op
}

fn node_then(node) {
  if rec.has(node, "then_n") then node.then_n else node.then_br
}

fn node_else(node) {
  if rec.has(node, "else_n") then node.else_n else node.else_br
}

fn node_fn_expr(node) {
  if rec.has(node, "fn_n") then node.fn_n else node.fn_
}

fn eval(node, env) {
  let t = node_t(node) in

  if t == "int"   then val_int(parse_int(str.from(node.v)))
  else if t == "float" then val_float(node.v)
  else if t == "bool"  then val_bool(node.v == "true" || node.v == true)
  else if t == "null"  then val_null()
  else if t == "str"   then val_text(node.v)

  else if t == "str_interp" then
    val_text(str.concat(list.map(node.parts, fn(part) {
      if part.kind == "text" then part.v
      else str.from(val_to_native(eval(part.expr, env)))
    })))

  else if t == "var" then
    let name = node_var_name(node) in
      let v = env_get(env, name) in
    if v == null then { t: "error", msg: str.concat(["unbound: ", name]) }
    else if typ.of(v) == "record" && rec.has(v, "t") && v.t == "rec_ref" then
      // Recursive reference - look up the actual fn in env
      let actual = env_get(env, v.name) in
      if actual == null || actual.t == "rec_ref" then { t: "error", msg: str.concat(["unresolved rec: ", v.name]) }
      else actual
    else v

  else if t == "bin" then
    let l = eval(node.left, env) in
    let r = eval(node.right, env) in
    eval_bin(node_bin_op(node), l, r)

  else if t == "unary" then
    let v = eval(node.expr, env) in
    eval_unary(node.op, v)

  else if t == "return" then
    { t: "return_val", v: eval(node.expr, env) }

  else if t == "try" then
    let r = eval(node.expr, env) in
    if r.t == "record" && rec.has(r.v, "t") && rec.get(r.v, "t").t == "text" && rec.get(r.v, "t").v == "err" then
      { t: "return_val", v: r }
    else if r.t == "record" && rec.has(r.v, "t") && rec.get(r.v, "t").t == "text" && rec.get(r.v, "t").v == "ok" && rec.has(r.v, "v") then
      rec.get(r.v, "v")
    else
      r

  else if t == "if" then
    let cond = eval(node.cond, env) in
    if is_truthy(cond)
      then eval(node_then(node), env)
      else eval(node_else(node), env)

  else if t == "let" then
    let v = eval(node.val, env) in
    if typ.of(v) == "record" && rec.has(v, "t") && v.t == "return_val" then v else eval(node.body, env_set(env, node.name, v))
  else if t == "let_pat" then
    let v = eval(node.val, env) in
    let env2 = bind_pattern(env, node.pat, v) in
    if typ.of(env2) == "record" && rec.has(env2, "t") && env2.t == "return_val" then env2 else if typ.of(env2) == "record" && rec.has(env2, "t") && env2.t == "error" then env2 else eval(node.body, env2)

  else if t == "list" then
    val_list(list.map(node.items, fn(item) { eval(item, env) }))

  else if t == "record" || t == "rec" then
    val_record(list.fold(node.fields, {}, fn(acc, f) {
      let key = if rec.has(f, "key") then f.key else f.k in
      let val_node = if rec.has(f, "val") then f.val else f.v in
      rec.set(acc, key, eval(val_node, env))
    }))

  else if t == "get" then
    let obj0 = eval(node.obj, env) in
    let obj = if typ.of(obj0) == "record" && rec.has(obj0, "t") then obj0 else val_record(obj0) in
    if obj.t == "record" then
      rec.getOr(obj.v, node.field, val_null())
    else if obj.t == "module" then
      { t: "module_method", path: obj.path, method: node.field }
    else if obj.t == "fn" || obj.t == "rec_fn" then
      // Method chaining not supported directly, return error with hint
      { t: "error", msg: str.concat(["get on fn: ", node.field]) }
    else { t: "error", msg: str.concat(["get on non-record: ", obj.t]) }

  else if t == "index" then
    let obj = eval(node.obj, env) in
    let idx = eval(node.idx, env) in
    if obj.t == "list" then list.get(obj.v, idx.v)
    else { t: "error", msg: "index on non-list" }

  else if t == "fn" then
    val_fn(node.params, node.body, env)

  else if t == "call" then
    let f0 = eval(node_fn_expr(node), env) in
    let f = if typ.of(f0) == "record" && rec.has(f0, "t") then f0 else val_record(f0) in
    let args = list.map(node.args, fn(a) { eval(a, env) }) in
    apply(f, args)

  else if t == "let_fn" then
    let f = val_fn(node.params, node.body, env) in
    eval(node.body_expr, env_set(env, node.name, f))

  else if t == "match" then
    let subject = eval(node.subj, env) in
    eval_match(subject, node.arms, env)

  else if t == "spread" then
    let base = eval(node.obj, env) in
    if base.t != "record" then
      { t: "error", msg: "spread expected record" }
    else
      val_record(list.fold(node.fields, base.v, fn(acc, f) {
        rec.set(acc, f.key, eval(f.val, env))
      }))

  else if t == "lambda" then
    // fn(x) => expr shorthand
    val_fn(node.params, node.body, env)

  else if t == "named_call" then
    // f(key: val, ...) — reorder args by param names
    let f = eval(node_fn_expr(node), env) in
    let arg_map = list.fold(node.named_args, {}, fn(acc, a) {
      rec.set(acc, a.name, eval(a.val, env))
    }) in
    let ordered_args = if f.t == "fn" || f.t == "rec_fn" then
      list.map(f.params, fn(p) { rec.getOr(arg_map, p, val_null()) })
    else list.map(node.named_args, fn(a) { eval(a.val, env) }) in
    apply(f, ordered_args)

  else { t: "error", msg: str.concat(["unknown node type: ", t]) }
}

fn apply(f, args) {
  if f.t == "fn" then
    let n = list.len(f.params) in
    let pairs = list.build(n, fn(i) {
      { name: list.get(f.params, i),
        val: if i < list.len(args) then list.get(args, i) else val_null() }
    }) in
    let r = eval(f.body, env_set_many(f.closure_env, pairs)) in
      if r.t == "return_val" then r.v else r
  else if f.t == "rec_fn" then
    let n = list.len(f.params) in
    let pairs = list.build(n, fn(i) {
      { name: list.get(f.params, i),
        val: if i < list.len(args) then list.get(args, i) else val_null() }
    }) in
    // Update env so self-reference resolves to this fn
    let self_env = env_set(f.env, f.name, f) in
    let r = eval(f.body, env_set_many(self_env, pairs)) in
      if r.t == "return_val" then r.v else r
  else if f.t == "builtin_fn" then
    apply_builtin_fn(f.name, args)
  else if f.t == "module_method" then
    apply_builtin_fn(str.concat([f.path, ".", f.method]), args)  else
    { t: "error", msg: str.concat(["call on non-fn: ", f.t]) }
}

fn apply_builtin_fn(name, args) {
  // Dispatch native list/str/rec primitives
  if name == "list.len"    then val_int(list.len(list.get(args, 0).v))
  else if name == "list.get"    then list.get(list.get(args, 0).v, list.get(args, 1).v)
  else if name == "list.append" then val_list(list.append(list.get(args, 0).v, list.get(args, 1)))
  else if name == "list.tail"   then val_list(list.tail(list.get(args, 0).v))
  else if name == "list.concat" then
    val_list(list.concat(list.map(list.get(args, 0).v, fn(xs) { xs.v })))
  else if name == "list.build"  then
    let n = list.get(args, 0).v in
    let f = list.get(args, 1) in
    val_list(list.build(n, fn(i) { apply(f, [val_int(i)]) }))
  else if name == "list.fold" then
    let xs = list.get(args, 0).v in
    let init = list.get(args, 1) in
    let f = list.get(args, 2) in
    list.fold(xs, init, fn(acc, x) { apply(f, [acc, x]) })
  else if name == "str.len"     then val_int(str.len(list.get(args, 0).v))
  else if name == "str.concat"  then
    val_text(str.concat(list.map(list.get(args, 0).v, fn(s) { s.v })))
  else if name == "str.slice"   then
    val_text(str.slice(list.get(args, 0).v, list.get(args, 1).v, list.get(args, 2).v))
  else if name == "str.split"   then
    val_list(list.map(str.split(list.get(args, 0).v, list.get(args, 1).v), fn(s) { val_text(s) }))
  else if name == "str.contains" then
    val_bool(str.contains(list.get(args, 0).v, list.get(args, 1).v))
  else if name == "str.from"    then val_text(str.from(list.get(args, 0).v))
  else if name == "str.join"    then
    val_text(str.join(list.map(list.get(args, 0).v, fn(s) { s.v }), list.get(args, 1).v))
  else if name == "str.replace" then
    val_text(str.replace(list.get(args, 0).v, list.get(args, 1).v, list.get(args, 2).v))
  else if name == "str.starts_with" then
    val_bool(str.starts_with(list.get(args, 0).v, list.get(args, 1).v))
  else if name == "str.trim"    then val_text(str.trim(list.get(args, 0).v))
  else if name == "int.parse" then val_int(int_mod.parse(list.get(args, 0).v).v)
  else if name == "int.pow" then val_int(int_mod.pow(list.get(args, 0).v, list.get(args, 1).v))
  else if name == "str.lower"   then val_text(str.lower(list.get(args, 0).v))
  else if name == "result.ok" then val_record({ t: val_text("ok"), v: list.get(args, 0) })
  else if name == "result.err" then val_record({ t: val_text("err"), e: list.get(args, 0) })
  else if name == "result.andThen" || name == "result.and_then" then
    let r = list.get(args, 0) in
    let f = list.get(args, 1) in
    if r.t == "record" && rec.has(r.v, "t") && rec.get(r.v, "t").v == "ok" then apply(f, [rec.get(r.v, "v")]) else r
  else if name == "str.lines"   then val_list(list.map(str.split(list.get(args, 0).v, "\n"), fn(s) { val_text(s) }))
  else if name == "result.unwrap_ok" then
    let r = list.get(args, 0) in
    if r.t == "record" && rec.has(r.v, "v") then rec.get(r.v, "v") else val_null()
  else if name == "result.unwrap_err" then
    let r = list.get(args, 0) in
    if r.t == "record" && rec.has(r.v, "e") then rec.get(r.v, "e") else val_null()
  else if name == "str.split_lines" then val_list(list.map(str.split(list.get(args, 0).v, "\n"), fn(s) { val_text(s) }))
  else if name == "rec.has"     then val_bool(rec.has(list.get(args, 0).v, list.get(args, 1).v))
  else if name == "rec.get"     then rec.get(list.get(args, 0).v, list.get(args, 1).v)
  else if name == "rec.set"     then
    val_record(rec.set(list.get(args, 0).v, list.get(args, 1).v, list.get(args, 2)))
  else if name == "rec.keys"    then
    val_list(list.map(rec.keys(list.get(args, 0).v), fn(k) { val_text(k) }))
  else if name == "rec.getOr"   then
    let r = list.get(args, 0).v in
    let k = list.get(args, 1).v in
    let d = list.get(args, 2) in
    if rec.has(r, k) then rec.get(r, k) else d
  else if name == "rec.remove"  then
    val_record(rec.remove(list.get(args, 0).v, list.get(args, 1).v))
  else if name == "rec.merge"   then
    val_record(rec.merge(list.get(args, 0).v, list.get(args, 1).v))
  else if name == "list.map" then
    let xs = list.get(args, 0).v in
    let f  = list.get(args, 1) in
    val_list(list.map(xs, fn(x) { apply(f, [x]) }))
  else if name == "list.filter" then
    let xs = list.get(args, 0).v in
    let f  = list.get(args, 1) in
    val_list(list.filter(xs, fn(x) { is_truthy(apply(f, [x])) }))
  else if name == "list.any" then
    let xs = list.get(args, 0).v in
    let f  = list.get(args, 1) in
    val_bool(list.any(xs, fn(x) { is_truthy(apply(f, [x])) }))
  else if name == "list.all" then
    let xs = list.get(args, 0).v in
    let f  = list.get(args, 1) in
    val_bool(list.all(xs, fn(x) { is_truthy(apply(f, [x])) }))
  else if name == "list.find" then
    let xs = list.get(args, 0).v in
    let f  = list.get(args, 1) in
    let r  = list.find(xs, fn(x) { is_truthy(apply(f, [x])) }) in
    if rec.has(r, "some") then { t: "record", v: { some: r.some } }
    else { t: "record", v: { none: null } }
  else if name == "list.head" then list.get(list.get(args, 0).v, 0)
  else if name == "list.last" then
    let xs = list.get(args, 0).v in
    list.get(xs, list.len(xs) - 1)
  else if name == "list.take" then
    let xs = list.get(args, 0).v in
    let n  = list.get(args, 1).v in
    val_list(list.take(xs, n))
  else if name == "list.drop" then
    let xs = list.get(args, 0).v in
    let n  = list.get(args, 1).v in
    val_list(list.drop(xs, n))
  else if name == "list.reverse" then
    val_list(list.reverse(list.get(args, 0).v))
  else if name == "list.zip" then
    val_list(list.map(list.zip(list.get(args, 0).v, list.get(args, 1).v),
      fn(pair) { val_list(pair) }))
  else if name == "list.flatten" then
    val_list(list.flatten(list.map(list.get(args, 0).v, fn(xs) { xs.v })))
  else if name == "list.range" then
    val_list(list.map(list.range(list.get(args, 0).v, list.get(args, 1).v), fn(n) { val_int(n) }))
  else if name == "list.repeat" then
    val_list(list.repeat(list.get(args, 0), list.get(args, 1).v))
  else if name == "list.sum" then
    val_int(list.fold(list.get(args, 0).v, 0, fn(acc, x) { acc + x.v }))
  else if name == "list.join" then
    val_text(str.join(list.map(list.get(args, 0).v, fn(s) { s.v }), list.get(args, 1).v))
  else if name == "list.sort_by" then
    let xs = list.get(args, 0).v in
    let f  = list.get(args, 1) in
    val_list(list.sort_by(xs, fn(a, b) { apply(f, [a, b]).v }))
  else if name == "list.group_by" then
    let xs  = list.get(args, 0).v in
    let f   = list.get(args, 1) in
    val_record(list.fold(xs, {}, fn(acc, x) {
      let k = apply(f, [x]).v in
      let existing = rec.getOr(acc, k, val_list([])) in
      rec.set(acc, k, val_list(list.append(existing.v, x)))
    }))
  else if name == "list.flat_map" then
    let xs = list.get(args, 0).v in
    let f  = list.get(args, 1) in
    val_list(list.flatten(list.map(xs, fn(x) { apply(f, [x]).v })))
  else { t: "error", msg: str.concat(["unknown builtin: ", name]) }
}

// ── Module evaluator ──────────────────────────────────────────────────────────

fn eval_module_with_env_result(module_node, initial_env) {
  let items = module_node.items in
  list.fold(items, { env: initial_env, val: val_null() }, fn(acc, item) {
    if item.t == "let_item" then
      let v = eval(item.val, acc.env) in
      { env: env_set(acc.env, item.name, v), val: v }
    else if item.t == "fn_item" then
      let env_with_self = env_set(acc.env, item.name, val_null()) in
      let f = { t: "rec_fn", name: item.name, params: item.params, body: item.body, env: env_with_self } in
      let env2 = env_set(acc.env, item.name, f) in
      let f2 = { t: "rec_fn", name: item.name, params: item.params, body: item.body, env: env2 } in
      let env3 = env_set(acc.env, item.name, f2) in
      { env: env3, val: f2 }
    else if item.t == "while_item" then
      let init_v = eval(item.init, acc.env) in
      let cond_f = eval(item.cond, acc.env) in
      let body_f = eval(item.body, acc.env) in
      let v = while_step(init_v, cond_f, body_f) in
      { env: acc.env, val: v }
    else if item.t == "import" then
      if is_relative_import_path(item.path) then
        let imported = eval_relative_import(item.path, acc.env) in
        if typ.of(imported) == "record" && rec.has(imported, "t") && imported.t == "error" then { env: acc.env, val: imported }
        else { env: env_set(acc.env, item.alias, env_to_record_value(imported.env)), val: imported.val }
      else
        acc
    else if item.t == "expr_item" then
      let v = eval(item.expr, acc.env) in
      { env: acc.env, val: v }
    else acc
  })
}

fn eval_module_with_env(module_node, initial_env) {
  eval_module_with_env_result(module_node, initial_env).val
}

fn eval_module(module_node) {
  let items = module_node.items in
  // First pass: collect all fn names to build a forward-reference env
  let fn_names = list.fold(items, [], fn(acc, item) {
    if item.t == "fn_item" then list.append(acc, item.name) else acc
  }) in
  // Second pass: evaluate items, using a shared mutable-style env
  // For recursive fns: we use a special { t: "rec_fn" } value that
  // defers lookup to the module env at call time
  let result = list.fold(items, { env: env_empty(), val: val_null() }, fn(acc, item) {
    if item.t == "let_item" then
      let v = eval(item.val, acc.env) in
      { env: env_set(acc.env, item.name, v), val: v }
    else if item.t == "fn_item" then
      // Build fn with current env — recursive calls will find name in env
      // because we pre-register a placeholder then overwrite
      let env1 = env_set(acc.env, item.name, { t: "rec_ref", name: item.name }) in
      let f = { t: "rec_fn", name: item.name, params: item.params, body: item.body, env: env1 } in
      let env2 = env_set(acc.env, item.name, f) in
      { env: env2, val: f }
    else if item.t == "while_item" then
      let init_v = eval(item.init, acc.env) in
      let cond_f = eval(item.cond, acc.env) in
      let body_f = eval(item.body, acc.env) in
      let v = while_step(init_v, cond_f, body_f) in
      { env: acc.env, val: v }
    else if item.t == "import" then
      // Import is handled at load time by the Rust host
      // In fard_eval context, we note it but can't resolve modules
      // For now: set alias to a placeholder record
      { env: env_set(acc.env, item.alias, { t: "module", path: item.path }), val: acc.val }
    else if item.t == "expr_item" then
      let v = eval(item.expr, acc.env) in
      { env: acc.env, val: v }
    else acc
  }) in
  result.val
}

fn match_record_pattern(subject, pat) {
  if subject.t != "record" then false
  else if pat.t != "rec" then false
  else list.all(pat.fields, fn(f) {
    let k = if rec.has(f, "key") then f.key else f.k in
    if !rec.has(subject.v, k) then false
    else
      let pv = if rec.has(f, "val") then f.val else f.v in
      if pv.t == "var" then true else values_eq(rec.get(subject.v, k), eval(pv, []))
  })
}

fn eval_match(subject, arms, env) {
  if list.len(arms) == 0 then val_null()
  else
    let arm = list.get(arms, 0) in
    let rest = list.drop(arms, 1) in
    let pat = arm.pat in
    if pat.t == "var" && pat.v == "_" then eval(arm.body, env)
    else if match_record_pattern(subject, pat) then eval(arm.body, env)
    else
      let pat_val = eval(pat, env) in
      if values_eq(subject, pat_val) then eval(arm.body, env)
      else eval_match(subject, rest, env)
}

fn values_eq(a, b) {
  if a.t != b.t then false
  else if a.t == "int" || a.t == "float" || a.t == "bool" || a.t == "text" then a.v == b.v
  else false
}


// ── Value unwrapping ──────────────────────────────────────────────────────────

fn val_to_native(val) {
  if val.t == "int"    then val.v
  else if val.t == "float"  then val.v
  else if val.t == "bool"   then val.v
  else if val.t == "null"   then null
  else if val.t == "text"   then val.v
  else if val.t == "list"   then list.map(val.v, fn(x) { val_to_native(x) })
  else if val.t == "record" then
    let keys = rec.keys(val.v) in
    list.fold(keys, {}, fn(acc, k) {
      rec.set(acc, k, val_to_native(rec.get(val.v, k)))
    })
  else if val.t == "native_call" then
    // Native module call - cannot unwrap, return as-is for host handling
    { native_call: true, path: val.path, method: val.method,
      args: list.map(val.args, fn(a) { val_to_native(a) }) }
  else val
}

export { eval, apply, apply_builtin_fn, eval_module, eval_module_with_env, val_to_native, eval_bin, eval_unary,
         val_int, val_float, val_bool, val_null, val_text, val_list, val_record, val_fn,
         env_empty, env_set, env_get, env_set_many, bind_pattern, env_to_record_value,
         is_relative_import_path, resolve_import_path, eval_relative_import, eval_module_with_env_result,
         is_truthy, while_step, values_eq, parse_int,
         node_t, node_var_name, node_bin_op, node_then, node_else, node_fn_expr }
