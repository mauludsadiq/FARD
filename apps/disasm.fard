import("fardparse")      as par
import("fard_lower")     as lower
import("fard_emit")      as emit
import("std/str")        as str
import("std/fs")         as fs
import("std/bytes")      as bytes
import("std/list")       as list
import("std/int")        as int

let src    = fs.read_text("hello4.fard")
let tokens = str.lex_tokens(src)
let parsed = par.parse_module(tokens, 0)
let ir     = lower.lower_program(parsed.node)
let bc     = emit.emit(ir)

// Dump bytecode as hex
fn dump_bytes(bc, i, acc) {
  if i >= bytes.len(bc) then acc
  else
    let b = bytes.get(bc, i) in
    dump_bytes(bc, i + 1, list.append(acc, b))
}

{ bc_len: bytes.len(bc), bytes: dump_bytes(bc, 0, []) }
