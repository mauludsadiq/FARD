import("fardlex")      as lex
import("fardparse")    as par
import("fard_lower")   as lower
import("fard_codegen") as cg
import("std/fs")       as fs
import("std/array")    as array

let src    = fs.read_text("apps/fardc_native.fard")
let tokens = lex.tokenize(src)
let parsed = par.parse_module(tokens, 0)
let ir     = lower.lower_program(parsed.node)
let cgx    = cg.codegen(ir)
{ n_fns: array.len(cgx.fn_addrs), ok: true }
