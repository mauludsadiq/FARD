import("apps/fardparse")    as par
import("apps/fard_lower")   as lower
import("apps/fard_codegen") as cg
import("apps/fard_elf")     as elf
import("std/str")   as str
import("std/fs")    as fs
import("std/bytes") as bytes

let src = "let cs = str.chars(\"hello\")\nlist.len(cs)"
let tokens = str.lex_tokens(src)
let ast    = par.parse_module(tokens, 0)
let ir     = lower.lower_program(ast.node)
let cg_res = cg.codegen(ir)
let binary = elf.build_elf(cg_res)
let _      = fs.write_bytes("fardc_out2/str_chars", binary)
{ ok: true }
