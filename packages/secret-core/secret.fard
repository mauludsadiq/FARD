/// secret-core — secret loading, redaction, and sealed config values

import("std/env")  as env
import("std/str")  as str
import("std/rec")  as rec
import("std/list") as list
import("std/hash")   as hash
import("std/type")   as typ

fn new() { { secrets: {}, redacted: [] } }

fn load_env(store, key, env_var) {
  let raw = env.get(env_var) in
  let val = if typ.of(raw) == "text" then raw else null in
  if val == null then { store: store, ok: false, err: str.concat(["missing env var: ", env_var]) }
  else { store: { ...store, secrets: rec.set(store.secrets, key, val) }, ok: true }
}

fn load_env_or(store, key, env_var, default_val) {
  let raw = env.get(env_var) in
  let val = if typ.of(raw) == "text" then raw else null in
  let v   = if val == null then default_val else val in
  { store: { ...store, secrets: rec.set(store.secrets, key, v) }, ok: true }
}

fn get(store, key) {
  rec.getOr(store.secrets, key, null)
}

fn require(store, key) {
  let v = rec.getOr(store.secrets, key, null) in
  if v == null then { ok: false, err: str.concat(["secret not found: ", key]) }
  else { ok: true, v: v }
}

fn seal(store, key) {
  if !rec.has(store.secrets, key) then store
  else
    let val = rec.get(store.secrets, key) in
    let digest = hash.sha256_text(val) in
    { ...store,
      secrets: rec.set(store.secrets, key, { sealed: true, digest: digest }),
      redacted: list.append(store.redacted, key) }
}

fn is_sealed(store, key) {
  let v = rec.getOr(store.secrets, key, null) in
  v != null && rec.has(v, "sealed") && v.sealed
}

fn redact(store, key) {
  { ...store,
    secrets: rec.set(store.secrets, key, "[REDACTED]"),
    redacted: list.append(store.redacted, key) }
}

fn safe_dump(store) {
  let keys = rec.keys(store.secrets) in
  list.fold(keys, {}, fn(acc, k) {
    let v = rec.get(store.secrets, k) in
    let safe = if list.any(store.redacted, fn(r) { r == k }) then "[REDACTED]"
               else if typ.of(v) == "record" && rec.has(v, "sealed") then str.concat(["[SEALED:", v.digest, "]"])
               else "[PRESENT]" in
    rec.set(acc, k, safe)
  })
}

fn require_all(store, keys) {
  list.fold(keys, { ok: true, missing: [] }, fn(acc, k) {
    if rec.has(store.secrets, k) then acc
    else { ok: false, missing: list.append(acc.missing, k) }
  })
}

export { new, load_env, load_env_or, get, require, seal, is_sealed,
         redact, safe_dump, require_all }
