// yaml@1.6.0 — YAML parsing and generation for FARD
import("std/str")  as str
import("std/list") as list
import("std/rec")  as rec
import("std/type") as type
import("std/int")  as int

fn parse_scalar(raw) {
  let v = str.trim(raw) in
  if v == "true"  then true
  else if v == "false" then false
  else if v == "null" || v == "~" then null
  else
    let parsed = int.parse(v) in
    if parsed.t == "ok" then parsed.v else v
}
fn is_list_item(line) {
  str.starts_with(str.trim(line), "- ")
}

fn parse_list_item(line) {
  let trimmed = str.trim(line)
  parse_scalar(str.trim(str.slice(trimmed, 2, str.len(trimmed))))
}

fn parse_kv_line(line) {
  let trimmed = str.trim(line)
  let parts   = str.split(trimmed, ":")
  let key     = str.trim(list.get(parts, 0))
  let raw     = str.trim(str.join(list.drop(parts, 1), ":"))
  { key: key, v: if str.len(raw) == 0 then null else parse_scalar(raw) }
}

fn apply_list_item(state, line) {
  let acc = state.acc in
  let cur_key = state.cur_key in
  let item = parse_list_item(line) in
  if cur_key != null then
    let existing = if rec.has(acc, cur_key) && type.of(rec.get(acc, cur_key)) == "list"
      then rec.get(acc, cur_key) else [] in
    { acc: rec.set(acc, cur_key, list.concat([existing, [item]])), cur_key: cur_key }
  else
    let existing = if rec.has(acc, "_list") then rec.get(acc, "_list") else [] in
    { acc: rec.set(acc, "_list", list.concat([existing, [item]])), cur_key: null }
}

fn apply_kv(state, line) {
  let kv = parse_kv_line(line) in
  { acc: rec.set(state.acc, kv.key, kv.v), cur_key: if kv.v == null then kv.key else null }
}

fn apply_yaml_line(state, line) {
  let trimmed = str.trim(line) in
  if str.len(trimmed) == 0 then state
  else if str.starts_with(trimmed, "#") then state
  else if is_list_item(line) then apply_list_item(state, line)
  else if str.contains(trimmed, ":") then apply_kv(state, line)
  else state
}

fn parse(src) {
  let initial = { acc: {}, cur_key: null } in
  let result = list.fold(str.split_lines(src), initial, fn(state, line) {
    apply_yaml_line(state, line)
  }) in
  let final = result.acc in
  if rec.has(final, "_list") then rec.get(final, "_list") else final
}

fn encode_scalar(v) {
  let t = type.of(v)
  if t == "text"  then v
  else if t == "bool"  then if v then "true" else "false"
  else if t == "null"  then "null"
  else if t == "int"   then str.from_int(v)
  else if t == "float" then str.from_float(v)
  else ""
}

fn encode_list_items(items) {
  let lines = list.map(items, fn(item) { str.concat("- ", encode_scalar(item)) })
  str.join(lines, "\n")
}

fn encode_pair(k, data) {
  let v = rec.get(data, k)
  let t = type.of(v)
  if t == "list" then
    str.concat(str.concat(k, ":\n"), encode_list_items(v))
  else
    str.concat(str.concat(k, ": "), encode_scalar(v))
}

fn encode(data) {
  let keys  = rec.keys(data)
  let lines = list.map(keys, fn(k) { encode_pair(k, data) })
  str.join(lines, "\n")
}

{ parse: parse, encode: encode }
