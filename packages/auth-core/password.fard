/// auth-core/password — password hashing and verification

import("std/hash")   as hash
import("std/crypto") as crypto
import("std/uuid")   as uuid
import("std/str")    as str
import("std/bytes")  as bytes

fn hash_password(password) {
  let salt = uuid.v4() in
  let salted = str.concat([salt, ":", password]) in
  let hashed = hash.sha256_text(salted) in
  str.concat([salt, ":", hashed])
}

fn verify_password(password, stored) {
  // stored format: "salt:sha256:hexhash"
  let colon1 = str.index_of(stored, ":") in
  if colon1 < 0 then false
  else
    let salt = str.slice(stored, 0, colon1) in
    let expected = str.slice(stored, colon1 + 1, str.len(stored)) in
    let salted = str.concat([salt, ":", password]) in
    let actual = hash.sha256_text(salted) in
    actual == expected
}

import("std/list") as list

export { hash_password, verify_password }
