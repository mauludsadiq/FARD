/// std/option — option type helpers


// Constructors
fn some(v)  { option.some(v) }
fn none()   { option.none() }

// Predicates (pure FARD)
fn is_some(o) { option.is_some(o) }
fn is_none(o) { option.is_none(o) }

// Transforms (pure FARD)
fn map(o, f) {
  if is_some(o) then some(f(option.to_nullable(o)))
  else none()
}

fn and_then(o, f) {
  if is_some(o) then f(option.to_nullable(o))
  else none()
}

fn unwrap_or(o, default_val) {
  if is_some(o) then option.to_nullable(o)
  else default_val
}

fn unwrap_or_else(o, f) {
  if is_some(o) then option.to_nullable(o)
  else f()
}

fn to_nullable(o) { option.to_nullable(o) }
fn from_nullable(v) { option.from_nullable(v) }

fn to_result(o, err) {
  if is_some(o) then { ok: true, v: option.to_nullable(o) }
  else { ok: false, err: err }
}

fn or_else(o, f) {
  if is_some(o) then o else f()
}

fn filter(o, pred) {
  if is_some(o) && pred(option.to_nullable(o)) then o else none()
}

export { some, none, is_some, is_none, map, and_then, unwrap_or,
         unwrap_or_else, to_nullable, from_nullable, to_result, or_else, filter }
