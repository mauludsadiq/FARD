/// std/env — environment variable access

import("std/env")  as _env
import("std/str")  as str
import("std/type") as typ

fn get(key)           { _env.get(key) }
fn args()             { _env.args() }

// Pure helpers — env.get returns {none:null} for missing vars
fn get_or(key, default_val) {
  let raw = _env.get(key) in
  if typ.of(raw) == "text" then raw else default_val
}

fn require(key) {
  let raw = _env.get(key) in
  if typ.of(raw) == "text" then { ok: true, v: raw }
  else { ok: false, err: str.concat(["missing env var: ", key]) }
}

fn get_int(key, default_val) {
  let raw = get_or(key, null) in
  if raw == null then default_val
  else
    let parsed = int.parse(raw) in
    if parsed.t == "ok" then parsed.v else default_val
}

fn get_bool(key, default_val) {
  let raw = get_or(key, null) in
  if raw == null then default_val
  else if raw == "true" || raw == "1" then true
  else if raw == "false" || raw == "0" then false
  else default_val
}

import("std/int") as int

export { get, args, get_or, require, get_int, get_bool }
