/// std/uuid — UUID generation and validation

import("std/str")  as str

fn v4()          { uuid.v4() }
fn validate(s)   { uuid.validate(s) }

// Pure helpers
fn short(u)      { str.slice(u, 0, 8) }
fn nil()         { "00000000-0000-0000-0000-000000000000" }
fn is_nil(u)     { u == nil() }

export { v4, validate, short, nil, is_nil }
