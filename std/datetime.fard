/// std/datetime — date/time helpers

import("std/str")      as str
import("std/int")      as int

// Native wrappers
fn now()            { datetime.now() }
fn parse(s, fmt)    { datetime.parse(s, fmt) }
fn format(ts, fmt)  { datetime.format(ts, fmt) }
fn add(ts, ms)      { datetime.add(ts, ms) }
fn sub(ts, ms)      { datetime.sub(ts, ms) }
fn diff(t0, t1)     { datetime.diff(t0, t1) }
fn field(ts, f)     { datetime.field(ts, f) }

// Pure helpers
fn now_ms()         { now() }

fn seconds(n)       { n * 1000 }
fn minutes(n)       { n * 60000 }
fn hours(n)         { n * 3600000 }
fn days(n)          { n * 86400000 }

fn elapsed_ms(t0)   { diff(t0, now()) }

fn iso(ts) { format(ts, "%Y-%m-%dT%H:%M:%S") }
fn date(ts) { format(ts, "%Y-%m-%d") }
fn time(ts) { format(ts, "%H:%M:%S") }

export { now, parse, format, add, sub, diff, field, now_ms,
         seconds, minutes, hours, days, elapsed_ms, iso, date, time }
