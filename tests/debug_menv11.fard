import("../packages/fard_eval/eval") as ev
import("../packages/fard_parse/parse") as parse
import("std/list") as list
import("std/record") as rec
import("std/type") as type
import("std/io") as io
import("std/menv") as menv

let src = io.read_file("packages/fard_eval/eval.fard").ok
let defs = parse.parse_program(src)
let e = menv.new()
menv.set(e, "list", list)
menv.set(e, "rec", rec)
menv.set(e, "type", type)
menv.set(e, "menv", menv)
let dummy = list.fold(defs, null, fn(acc, d) {
  if d.t == "def_fn" then menv.set(e, d.name, ev.eval(d, e)) else null
})
let self_eval = menv.get(e, "eval")

let fib_src = "fn fib(n) { if n <= 1 then n else fib(n - 1) + fib(n - 2) }"
let fib_defs = parse.parse_program(fib_src)
let user_env = menv.new()
menv.set(user_env, "list", list)
menv.set(user_env, "rec", rec)

let fib_cl = ev.apply_fn(self_eval, [fib_defs[0], user_env])
menv.set(user_env, "fib", fib_cl)

let call5 = { t: "call", fn: { t: "var", name: "fib" }, args: [{ t: "lit_int", v: 5 }] }
let r = ev.apply_fn(self_eval, [call5, user_env])
test "fib 5 = 5" { r == 5 }

let call10 = { t: "call", fn: { t: "var", name: "fib" }, args: [{ t: "lit_int", v: 10 }] }
let r10 = ev.apply_fn(self_eval, [call10, user_env])
test "fib 10 = 55" { r10 == 55 }
