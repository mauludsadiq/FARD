
import("std/record") as rec
import("std/list") as list
import("std/type") as type
import("std/str") as str

// Deep record operations

// Path-based access
fn get_path(obj, path) {
  list.fold(str.split(path, "."), obj, fn(acc, key) {
    if acc == null then null
    else if rec.has(acc, key) then rec.get(acc, key)
    else null
  })
}
let nested = { a: { b: { c: 42 } }, x: { y: "hello" } }
test "get path simple" { get_path(nested, "a.b.c") == 42 }
test "get path string" { get_path(nested, "x.y") == "hello" }
test "get path missing" { get_path(nested, "a.z") == null }
test "get path deep" { get_path(nested, "a.b.c") == 42 }

// Record diffing
fn diff_records(a, b) {
  let a_keys = rec.keys(a) in
  let b_keys = rec.keys(b) in
  let all_keys = list.filter(
    list.concat([a_keys, list.filter(b_keys, fn(k) { list.any(a_keys, fn(ak) { ak == k }) == false })]),
    fn(_) { true }
  ) in
  list.filter(list.map(all_keys, fn(k) {
    let av = rec.get(a, k) in
    let bv = rec.get(b, k) in
    if av == bv then null
    else { key: k, from: av, to: bv }
  }), fn(d) { d != null })
}
let d = diff_records({ x: 1, y: 2, z: 3 }, { x: 1, y: 99, z: 3 })
test "diff count" { list.len(d) == 1 }
test "diff key" { list.get(d, 0).key == "y" }
test "diff from" { list.get(d, 0).from == 2 }
test "diff to" { list.get(d, 0).to == 99 }

let no_diff = diff_records({ x: 1 }, { x: 1 })
test "no diff" { list.len(no_diff) == 0 }

// Record builder pattern
fn builder(initial) {
  { data: initial,
    set: fn(self, key, val) { builder(rec.set(self.data, key, val)) },
    build: fn(self) { self.data }
  }
}
let b = builder({})
let b1 = b.set(b, "name", "Alice")
let b2 = b1.set(b1, "age", 30)
let result = b2.build(b2)
test "builder name" { result.name == "Alice" }
test "builder age" { result.age == 30 }

// Record merge deep
fn deep_merge(a, b) {
  list.fold(rec.keys(b), a, fn(acc, k) {
    let bv = rec.get(b, k) in
    let av = rec.get(acc, k) in
    if type.of(av) == "record" && type.of(bv) == "record" then
      rec.set(acc, k, deep_merge(av, bv))
    else
      rec.set(acc, k, bv)
  })
}
let base = { a: { x: 1, y: 2 }, b: 3 }
let override = { a: { y: 99, z: 100 }, c: 4 }
let merged = deep_merge(base, override)
test "deep merge x kept" { merged.a.x == 1 }
test "deep merge y overridden" { merged.a.y == 99 }
test "deep merge z added" { merged.a.z == 100 }
test "deep merge b kept" { merged.b == 3 }
test "deep merge c added" { merged.c == 4 }

// Record as namespace
fn make_math_ns() {
  { pi: 3.14159,
    e: 2.71828,
    square: fn(x) { x * x },
    cube: fn(x) { x * x * x }
  }
}
let m = make_math_ns()
test "ns pi" { m.pi > 3.14 }
test "ns square" { m.square(5) == 25 }
test "ns cube" { m.cube(3) == 27 }
