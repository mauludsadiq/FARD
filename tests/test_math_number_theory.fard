import("std/list") as list
import("std/math") as math

fn gcd(a, b) { if b == 0 then a else gcd(b, a % b) }
fn lcm(a, b) { (a * b) / gcd(a, b) }
fn is_prime(n) {
  if n < 2 then false
  else if n == 2 then true
  else if n % 2 == 0 then false
  else
    let limit = math.floor(math.sqrt(n + 0.0)) in
    let r = while { i: 3, ok: true }
      fn(s) { s.i <= limit && s.ok }
      fn(s) { { i: s.i + 2, ok: n % s.i != 0 } }
    in r.value.ok
}
fn prime_factors(n) {
  let r = while { n: n, i: 2, factors: [] }
    fn(s) { s.n > 1 }
    fn(s) {
      if s.n % s.i == 0 then { n: s.n / s.i, i: s.i, factors: list.concat([s.factors, [s.i]]) }
      else { n: s.n, i: s.i + 1, factors: s.factors }
    }
  in r.value.factors
}

test "gcd 48 18" { gcd(48, 18) == 6 }
test "gcd 100 75" { gcd(100, 75) == 25 }
test "gcd 7 13" { gcd(7, 13) == 1 }
test "gcd 0" { gcd(5, 0) == 5 }
test "lcm 4 6" { lcm(4, 6) == 12 }
test "lcm 7 5" { lcm(7, 5) == 35 }
test "prime 2" { is_prime(2) }
test "prime 3" { is_prime(3) }
test "prime 97" { is_prime(97) }
test "not prime 1" { is_prime(1) == false }
test "not prime 4" { is_prime(4) == false }
test "not prime 100" { is_prime(100) == false }
test "factors 12" { prime_factors(12) == [2,2,3] }
test "factors 100" { prime_factors(100) == [2,2,5,5] }
test "factors prime" { prime_factors(17) == [17] }

fn euler_totient(n) {
  list.len(list.filter(list.range(1, n+1), fn(k) { gcd(k, n) == 1 }))
}
test "totient 1" { euler_totient(1) == 1 }
test "totient 6" { euler_totient(6) == 2 }
test "totient 7" { euler_totient(7) == 6 }
test "totient 10" { euler_totient(10) == 4 }

fn modpow(base, exp, mod) {
  if exp == 0 then 1
  else if exp % 2 == 0 then
    let half = modpow(base, exp / 2, mod) in
    (half * half) % mod
  else
    (base * modpow(base, exp - 1, mod)) % mod
}
test "modpow basic" { modpow(2, 10, 1000) == 24 }
test "modpow 3 5 7" { modpow(3, 5, 7) == 5 }
test "modpow 0" { modpow(5, 0, 13) == 1 }
