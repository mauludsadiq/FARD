
import("../packages/crypto-extra/main") as crypto
import("../packages/base64/main") as b64
import("../packages/hmac-sign/main") as hmac
import("std/str") as str
import("std/list") as list
import("std/type") as type

// Hash determinism
let h1 = crypto.hash_password("test", "salt1")
let h2 = crypto.hash_password("test", "salt1")
let h3 = crypto.hash_password("test", "salt2")
test "hash deterministic" { h1 == h2 }
test "diff salt diff hash" { h1 != h3 }
test "hash not empty" { str.len(h1) > 0 }

// Verify correctness
test "verify correct password" { crypto.verify_password("test", "salt1", h1) }
test "verify wrong password" { crypto.verify_password("wrong", "salt1", h1) == false }
test "verify wrong salt" { crypto.verify_password("test", "wrong_salt", h1) == false }

// HMAC determinism
let sig1 = hmac.sign("message", "secret")
let sig2 = hmac.sign("message", "secret")
let sig3 = hmac.sign("message", "other_secret")
test "hmac deterministic" { sig1 == sig2 }
test "hmac diff secret" { sig1 != sig3 }
test "hmac verify" { hmac.verify("message", "secret", sig1) }
test "hmac wrong msg" { hmac.verify("wrong", "secret", sig1) == false }

// Base64 correctness
test "b64 encode hello" { str.len(b64.encode("hello")) > 0 }
test "b64 roundtrip2" { b64.decode(b64.encode("hello")) == "hello" }
test "b64 roundtrip" { b64.decode(b64.encode("test string 123")) == "test string 123" }
test "b64 empty" { b64.encode("") == "" }
test "b64 url safe" { str.contains(b64.encode_url("hello+world"), "+") == false }

// Token generation
let tokens = list.map(list.range(0, 5), fn(_) { crypto.random_token() })
test "tokens unique" { list.len(tokens) == 5 }
test "token type" { type.of(list.get(tokens, 0)) == "text" }

// Hex encoding
let hex = crypto.random_hex(16)
test "hex len" { str.len(hex) == 32 }
test "hex type" { type.of(hex) == "text" }
