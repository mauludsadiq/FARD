
import("../packages/fard_eval/eval") as ev
import("../packages/fard_parse/parse") as parse
import("std/list") as list
import("std/record") as rec
import("std/type") as type
import("std/str") as str
import("std/menv") as menv
import("std/io") as io

let eval_src = io.read_file("packages/fard_eval/eval.fard").ok
let eval_defs = parse.parse_program(eval_src)
let e = menv.new()
menv.set(e, "list", list)
menv.set(e, "rec", rec)
menv.set(e, "type", type)
menv.set(e, "menv", menv)
menv.set(e, "str", str)
let dummy = list.fold(eval_defs, null, fn(acc, d) {
  if d.t == "def_fn" then menv.set(e, d.name, ev.eval(d, e)) else null
})
let self_eval = menv.get(e, "eval")

let st = { tokens: ["fn", "f", "(", "x", ")", "{", "x", "}"], pos: 0 }
let user_env = menv.new()
menv.set(user_env, "st", st)

let get_tokens_fir = { t: "get_field", obj: { t: "var", name: "st" }, field: "tokens" }
let r1 = ev.apply_fn(self_eval, [get_tokens_fir, user_env])
test "st.tokens type" { type.of(r1) }
test "st.tokens is list" { type.of(r1) == "list" }

let get_pos_fir = { t: "get_field", obj: { t: "var", name: "st" }, field: "pos" }
let r2 = ev.apply_fn(self_eval, [get_pos_fir, user_env])
test "st.pos type" { type.of(r2) }
test "st.pos is int" { type.of(r2) == "int" }

let index_fir = { t: "index", obj: { t: "get_field", obj: { t: "var", name: "st" }, field: "tokens" }, idx: { t: "get_field", obj: { t: "var", name: "st" }, field: "pos" } }
let r3 = ev.apply_fn(self_eval, [index_fir, user_env])
test "st.tokens[st.pos] type" { type.of(r3) }
test "st.tokens[st.pos] value" { r3 }
