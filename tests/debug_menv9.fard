import("../packages/fard_eval/eval") as ev
import("../packages/fard_parse/parse") as parse
import("std/list") as list
import("std/record") as rec
import("std/type") as type
import("std/io") as io
import("std/menv") as menv

let src = io.read_file("packages/fard_eval/eval.fard").ok
let defs = parse.parse_program(src)
let e = menv.new()
menv.set(e, "list", list)
menv.set(e, "rec", rec)
menv.set(e, "type", type)
menv.set(e, "menv", menv)
let dummy = list.fold(defs, null, fn(acc, d) {
  if d.t == "def_fn" then menv.set(e, d.name, ev.eval(d, e)) else null
})
let self_eval = menv.get(e, "eval")

let prog_src = "fn add(a, b) { a + b }  fn main() { add(3, 4) }"
let prog_defs = parse.parse_program(prog_src)

let prog_env = menv.new()
menv.set(prog_env, "list", list)
menv.set(prog_env, "rec", rec)

let prog_env2 = list.fold(prog_defs, prog_env, fn(acc, d) {
  if d.t == "def_fn" then
    let cl = ev.apply_fn(self_eval, [d, acc]) in
    let _ = menv.set(acc, d.name, cl) in
    acc
  else acc
})

let main_cl = menv.get(prog_env2, "main")
test "main is closure" { main_cl.t == "closure" }

let call_main = { t: "call", fn: { t: "var", name: "main" }, args: [] }
let result = ev.apply_fn(self_eval, [call_main, prog_env2])
test "main returns 7" { result == 7 }
