
import("../packages/semver/main") as semver
import("std/list") as list

let v = semver.parse("1.2.3")
test "parse major" { v.major == 1 }
test "parse minor" { v.minor == 2 }
test "gt" { semver.gt("2.0.0", "1.9.9") }
test "lt" { semver.lt("1.0.0", "1.0.1") }
test "eq" { semver.eq("1.2.3", "1.2.3") }
test "bump_major" { semver.bump_major("1.2.3") == "2.0.0" }
test "bump_minor" { semver.bump_minor("1.2.3") == "1.3.0" }
test "bump_patch" { semver.bump_patch("1.2.3") == "1.2.4" }
let versions = ["1.0.0", "2.0.0", "1.5.0"]
let latest = semver.latest(versions)
test "latest" { latest == "2.0.0" }
