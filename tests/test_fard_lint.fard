
import("../packages/fard-lint/main") as lint
import("std/list") as list
import("std/type") as type

let src = "fn foo(x) { x + 1 }"
let issues = lint.lint(src)
test "lint ok" { issues.ok }
test "no issues" { type.of(issues2) == "list" }

let issues2 = lint.lint_source(src)
test "lint_source type" { type.of(issues2) == "list" }

let w = lint.warning("unused", "variable unused", 1)
test "warning level" { w.level == "warning" }
test "warning rule" { w.rule == "unused" }

let e = lint.error("syntax", "bad syntax", 5)
test "error level" { e.level == "error" }
test "error line" { e.line == 5 }
