
import("std/env") as env
import("std/type") as type
import("std/rec") as rec

let path = env.get("PATH")
test "PATH exists" { rec.has(path, "some") }
test "PATH not empty" { path.some != "" }

let missing = env.get("FARD_TEST_NONEXISTENT_XYZ_12345")
test "missing is none" { rec.has(missing, "none") }

let home = env.get("HOME")
test "HOME type" { type.of(home) == "record" }

let args = env.args()
test "args type" { type.of(args) == "list" }
