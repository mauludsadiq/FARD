import("std/list") as list
import("std/math") as math

fn factorial(n) { if n <= 1 then 1 else n * factorial(n-1) }
fn choose(n, k) { factorial(n) / (factorial(k) * factorial(n-k)) }
fn permutations_count(n, k) { factorial(n) / factorial(n-k) }

test "choose 5 2" { choose(5, 2) == 10 }
test "choose 10 3" { choose(10, 3) == 120 }
test "choose n 0" { choose(7, 0) == 1 }
test "choose n n" { choose(6, 6) == 1 }
test "perm 5 2" { permutations_count(5, 2) == 20 }
test "perm 4 4" { permutations_count(4, 4) == 24 }

fn pascal_row(n) {
  list.fold(list.range(0, n+1), [1], fn(acc, k) {
    if k == n then acc
    else list.concat([acc, [choose(n, k+1)]])
  })
}
test "pascal 0" { pascal_row(0) == [1] }
test "pascal 3" { pascal_row(3) == [1,3,3,1] }
test "pascal 4" { pascal_row(4) == [1,4,6,4,1] }
test "pascal sum" { list.fold(pascal_row(5), 0, fn(acc, x) { acc + x }) == 32 }

fn combinations_list(xs, k) {
  if k == 0 then [[]]
  else if list.len(xs) < k then []
  else
    let with_head = list.map(combinations_list(list.tail(xs), k-1), fn(c) { list.concat([[list.head(xs)], c]) }) in
    list.concat([with_head, combinations_list(list.tail(xs), k)])
}
let c42 = combinations_list([1,2,3,4], 2)
test "comb 4 2 count" { list.len(c42) == 6 }
test "comb all size 2" { list.all(c42, fn(c) { list.len(c) == 2 }) }

fn permutations_list(xs) {
  if list.len(xs) == 0 then [[]]
  else list.flat_map(xs, fn(x) {
    let rest = list.filter(xs, fn(y) { y != x }) in
    list.map(permutations_list(rest), fn(p) { list.concat([[x], p]) })
  })
}
let p3 = permutations_list([1,2,3])
test "perm 3 count" { list.len(p3) == 6 }
test "perm all len 3" { list.all(p3, fn(p) { list.len(p) == 3 }) }
test "perm has 123" { list.any(p3, fn(p) { p == [1,2,3] }) }
test "perm has 321" { list.any(p3, fn(p) { p == [3,2,1] }) }

fn derangements(n) {
  if n == 0 then 1
  else if n == 1 then 0
  else (n-1) * (derangements(n-1) + derangements(n-2))
}
test "derange 0" { derangements(0) == 1 }
test "derange 1" { derangements(1) == 0 }
test "derange 3" { derangements(3) == 2 }
test "derange 4" { derangements(4) == 9 }
