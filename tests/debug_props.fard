
import("std/type") as type
import("std/list") as list

fn eq_test(a, b) { a == b }

let xs = [1,2,3]
let ys = [1,2,3]
test "direct" { xs == ys }
test "via fn" { eq_test(xs, ys) }
test "via fn int" { eq_test(1, 1) }
test "via fn bool" { eq_test(true, true) }
test "via fn null" { eq_test(null, null) }
test "via fn str" { eq_test("a", "a") }
