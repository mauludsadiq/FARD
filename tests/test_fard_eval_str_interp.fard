import("../apps/fard_eval") as ev

test "fard_eval string interpolation joins text and expr parts" {
  let node = {
    t: "str_interp",
    parts: [
      { kind: "text", v: "x=" },
      { kind: "expr", expr: { t: "int", v: 42 } }
    ]
  } in
  ev.eval(node, ev.env_empty()).v == "x=42"
}

test "fard_eval string interpolation reads env values" {
  let node = {
    t: "str_interp",
    parts: [
      { kind: "text", v: "hello " },
      { kind: "expr", expr: { t: "var", v: "name" } }
    ]
  } in
  let env = ev.env_set(ev.env_empty(), "name", ev.val_text("FARD")) in
  ev.eval(node, env).v == "hello FARD"
}
