import("std/list") as list
import("../std/str_impl") as S

test "starts_with true"  { S.starts_with("hello world", "hello") }
test "starts_with false" { !S.starts_with("hello world", "world") }
test "ends_with true"    { S.ends_with("hello world", "world") }
test "ends_with false"   { !S.ends_with("hello world", "hello") }
test "replace"           { S.replace("foo bar foo", "foo", "baz") == "baz bar baz" }
test "index_of hit"      { S.index_of("hello", "ell") == 1 }
test "index_of miss"     { S.index_of("hello", "xyz") == -1 }
test "pad_left"          { S.pad_left("42", 5, "0") == "00042" }
test "pad_right"         { S.pad_right("hi", 5, ".") == "hi..." }
test "repeat"            { S.repeat("ab", 3) == "ababab" }
test "lines"             { list.len(S.lines("a\nb\nc")) == 3 }
test "join"              { S.join(["a","b","c"], "-") == "a-b-c" }
test "len"               { S.len("hello") == 5 }
test "contains"          { S.contains("fardrun", "ard") }
test "trim"              { S.trim("  hi  ") == "hi" }
