import("../packages/secret-core/secret") as sec

test "secret load_env_or default" {
  let r = sec.load_env_or(sec.new(), "db_url", "DB_URL_NONEXISTENT_XYZ", "sqlite://default") in
  sec.get(r.store, "db_url") == "sqlite://default"
}

test "secret get missing" {
  sec.get(sec.new(), "missing") == null
}

test "secret require missing" {
  let r = sec.require(sec.new(), "key") in
  !r.ok
}

test "secret redact" {
  let r = sec.load_env_or(sec.new(), "pw", "PW_NONE", "s3cr3t") in
  let s = sec.redact(r.store, "pw") in
  sec.get(s, "pw") == "[REDACTED]"
}

test "secret safe_dump hides values" {
  let r = sec.load_env_or(sec.new(), "pw", "PW_NONE", "s3cr3t") in
  let dump = sec.safe_dump(r.store) in
  rec.get(dump, "pw") == "[PRESENT]"
}

test "secret safe_dump shows redacted" {
  let r = sec.load_env_or(sec.new(), "pw", "PW_NONE", "s3cr3t") in
  let s = sec.redact(r.store, "pw") in
  let dump = sec.safe_dump(s) in
  rec.get(dump, "pw") == "[REDACTED]"
}

test "secret require_all ok" {
  let r = sec.load_env_or(sec.new(), "k", "K_NONE", "v") in
  let check = sec.require_all(r.store, ["k"]) in
  check.ok
}

test "secret require_all missing" {
  let check = sec.require_all(sec.new(), ["k1", "k2"]) in
  !check.ok && list.len(check.missing) == 2
}

import("std/rec")  as rec
import("std/list") as list
