import("../packages/fard_eval/eval") as ev
import("std/list") as list
import("std/record") as rec
import("std/type") as type
import("../packages/fard_parse/parse") as parse
import("std/io") as io
import("std/menv") as menv

let src = io.read_file("packages/fard_eval/eval.fard").ok
let defs = parse.parse_program(src)
let env0 = menv.new()
let _list = menv.set(env0, "list", list)
let _rec = menv.set(env0, "rec", rec)
let _type = menv.set(env0, "type", type)
let env1 = list.fold(defs, env0, fn(acc, d) {
  if d.t == "def_fn" then
    let v = ev.eval(d, acc) in
      let _ = menv.set(acc, d.name, v) in
      acc
  else acc
})
let self_eval = ev.env_get(env1, "eval")
let user_env = ev.env_empty()

let r1 = ev.apply_fn(self_eval, [{ t: "lit_int", v: 42 }, user_env])
test "lit_int" { r1 == 42 }

let r2 = ev.apply_fn(self_eval, [{ t: "lit_bool", v: true }, user_env])
test "lit_bool" { r2 == true }

let add_node = { t: "call_builtin", name: "int.add", args: [{ t: "lit_int", v: 3 }, { t: "lit_int", v: 4 }] }
let r4 = ev.apply_fn(self_eval, [add_node, user_env])
test "call_builtin add" { r4 == 7 }
