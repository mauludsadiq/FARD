
import("std/str") as str
import("std/list") as list
import("std/int") as int

fn parse_digit() {
  fn(input) {
    if str.len(input) == 0 then { ok: false, value: null, rest: "" }
    else
      let c = str.slice(input, 0, 1) in
      let code = str.char_code(c) in
      if code >= 48 && code <= 57 then { ok: true, value: c, rest: str.slice(input, 1, str.len(input)) }
      else { ok: false, value: null, rest: "" }
  }
}
fn parse_many(parser) {
  fn(input) {
    let result = while { input: input, values: [] }
      fn(s) { str.len(s.input) > 0 }
      fn(s) {
        let r = parser(s.input) in
        if r.ok then { input: r.rest, values: list.concat([s.values, [r.value]]) }
        else { input: "", values: s.values }
      }
    in { ok: true, value: result.value.values, rest: result.value.input }
  }
}
fn parse_integer() {
  fn(input) {
    let digits_r = parse_many(parse_digit())(input) in
    if list.len(digits_r.value) == 0 then { ok: false, value: null, rest: "" }
    else
      let s = str.join(digits_r.value, "") in
      let r = int.parse(s) in
      if r.t == "ok" then { ok: true, value: r.v, rest: digits_r.rest }
      else { ok: false, value: null, rest: "" }
  }
}
let res = parse_integer()("123abc")
test "ok" { res.ok }
test "value" { res.value == 123 }
test "rest" { res.rest }
test "rest eq" { res.rest == "abc" }
